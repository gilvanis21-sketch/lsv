---
// Gabarit des pages intérieures : BaseLayout + bandeau de titre avec fil d'Ariane.
// Exemple :
//   <PageLayout title="Équipe" kicker="Le laboratoire" lead="…" crumbs={[{ label: 'Équipe' }]}>
//     <Section>…</Section>
//   </PageLayout>
import BaseLayout from './BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import type { ImageMetadata } from 'astro';
interface Props {
  title: string;
  description?: string;
  kicker?: string;
  lead?: string;
  crumbs?: { href?: string; label: string }[];
  image?: ImageMetadata;
  noindex?: boolean;
}
const { title, description, kicker, lead, crumbs = [{ label: title }], image, noindex } = Astro.props;
---
<BaseLayout title={title} description={description ?? lead} image={image} noindex={noindex}>
  <PageHero kicker={kicker} title={title} lead={lead} crumbs={crumbs}><slot name="hero" /></PageHero>
  <slot />
</BaseLayout>
