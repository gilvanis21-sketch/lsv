---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import NewsCard from '../components/NewsCard.astro';
import Note from '../components/Note.astro';
import VideoPlayer from '../components/VideoPlayer.astro';
import RdvForm from '../components/RdvForm.astro';
import { services, anomalies, actus, equipe } from '../data/contenus';
import { site } from '../data/site';
import poster from '../assets/provisoire/video-poster.jpg';
import logiciel from '../assets/provisoire/logiciel.jpg';
const fondateur = equipe[0];
---
<BaseLayout title="Accueil" description={site.description}>
  <div class="hero">
    <div class="wrap">
      <div>
        <span class="eyebrow">Laboratoire Scientifique de la Voix</span>
        <h1>Comprendre et prendre soin de <em>votre voix</em></h1>
        <p class="lead">Une approche scientifique et bienveillante pour analyser, préserver et améliorer votre voix, que vous soyez chanteur, enseignant, orateur ou simplement gêné au quotidien.</p>
        <div class="cta">
          <a class="btn btn-a" href="/rendez-vous/">Prendre rendez-vous</a>
          <a class="btn btn-o" href="/services/">Découvrir nos services</a>
        </div>
        <ul class="chips">
          <li>Approche scientifique</li>
          <li>Aucune donnée de santé en ligne</li>
          <li>Réponse sous 48&nbsp;h</li>
        </ul>
      </div>
      <div class="viz rv" aria-hidden="true">
        <div class="wave" data-wave></div>
        <div class="tag"><span>80 Hz</span><span>SPECTRE VOCAL</span><span>8&nbsp;kHz</span></div>
      </div>
    </div>
  </div>

  <Section id="services" alt kicker="Services" title="Un accompagnement adapté à chaque voix" sub="Chaque séance débute par une écoute attentive et se poursuit avec des méthodes claires, expliquées pas à pas.">
    <div class="grid">
      {services.map((s) => <Card num={s.num} title={s.titre} href={`/services/${s.slug}/`}>{s.resume}</Card>)}
    </div>
  </Section>

  <Section id="voix" kicker="Anomalies de la voix" title="Reconnaître les signes, savoir quand agir" sub="Votre voix change, se fatigue ou disparaît ? Voici les situations les plus fréquentes.">
    <div class="grid">
      {anomalies.map((a) => <Card title={a.titre}>{a.texte}</Card>)}
    </div>
    <Note title="Information, pas diagnostic.">Si votre voix reste altérée plus de deux semaines, consultez un médecin ou un ORL. Le laboratoire n’établit pas de diagnostic médical et ne promet aucune guérison.</Note>
    <p class="section-foot rv"><a class="btn btn-o" href="/la-voix/">En savoir plus sur la voix</a></p>
  </Section>

  <section id="logiciel" class="alt" aria-labelledby="logiciel-titre">
    <div class="wrap two center">
      <div class="rv">
        <div class="kick">Logiciel <span class="badge">Lancement en mars</span></div>
        <h2 id="logiciel-titre">POLYMNIVOX, la voix mesurée dans le temps</h2>
        <p class="sub sub-0">Un court enregistrement transformé en informations objectives et comparables d’une séance à l’autre. Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
        <p class="section-foot"><a class="btn btn-o" href="/logiciel/">Découvrir POLYMNIVOX</a></p>
      </div>
      <figure class="figure rv">
        <Image src={logiciel} alt="Capture d’écran provisoire du logiciel POLYMNIVOX" widths={[480, 800, 1100]} sizes="(max-width: 860px) 100vw, 540px" />
      </figure>
    </div>
  </section>

  <section id="video" aria-labelledby="video-titre">
    <div class="wrap two center">
      <VideoPlayer src="/media/presentation-provisoire.mp4" poster={poster} title="Présentation du laboratoire (vidéo provisoire)" captions="/media/presentation-provisoire.vtt" caption="Vidéo provisoire, remplacée par la présentation définitive." />
      <div class="rv">
        <div class="kick">En vidéo</div>
        <h2 id="video-titre">Le laboratoire en deux minutes</h2>
        <p class="sub sub-0">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Integer vitae lacus non magna faucibus tincidunt.</p>
      </div>
    </div>
  </section>

  <section id="references" class="alt" aria-labelledby="references-titre">
    <div class="wrap two">
      <div class="rv">
        <div class="kick">Références</div>
        <h2 id="references-titre">Une expertise de terrain</h2>
        <div class="who">
          <div class="av"><Image src={fondateur.photo} alt="" width={76} height={76} /></div>
          <div><b>{fondateur.nom}</b><br /><span>Ostéopathe et chef d’entreprise, fondateur du LSV</span></div>
        </div>
        <p class="muted">Présentez ici le parcours, la philosophie et la méthode du laboratoire : une manière simple de rassurer avant le premier rendez-vous.</p>
        <p class="section-foot cta"><a class="btn btn-o btn-s" href="/equipe/">L’équipe</a><a class="btn btn-o btn-s" href="/partenaires/">Partenaires</a></p>
      </div>
      <ul class="refs">
        <li class="rv"><b>Formations et diplômes</b><span>À compléter avec les éléments fournis par le client.</span></li>
        <li class="rv"><b>Collaborations et partenaires</b><span>Hôpitaux, écoles de musique, associations, entreprises.</span></li>
        <li class="rv"><b><a href="/recherche/">Publications et interventions</a></b><span>Articles, conférences, formations animées.</span></li>
        <li class="rv"><b><a href="/partenaires/#temoignages">Témoignages</a></b><span>Publiés uniquement avec l’accord écrit des personnes.</span></li>
      </ul>
    </div>
  </section>

  <Section id="actus" kicker="Actualités" title="Conseils et nouvelles du laboratoire">
    <div class="grid grid-3">
      {actus.slice(0, 3).map((a) => <NewsCard actu={a} />)}
    </div>
    <p class="section-foot rv"><a class="btn btn-o" href="/actualites/">Toutes les actualités</a></p>
  </Section>

  <section id="rdv" class="alt" aria-labelledby="rdv-titre">
    <div class="wrap two">
      <div class="rv">
        <div class="kick">Rendez-vous</div>
        <h2 id="rdv-titre">Réservez votre séance en deux minutes</h2>
        <p class="sub sub-0">Choisissez une prestation et un créneau souhaité : nous vous confirmons le rendez-vous par e-mail.</p>
        <ol class="steps">
          <li><span class="num">1</span><span><b>Vous envoyez votre demande</b><br />Uniquement vos coordonnées et vos disponibilités.</span></li>
          <li><span class="num">2</span><span><b>Vous recevez une confirmation</b><br />Par e-mail, avec un lien pour annuler.</span></li>
          <li><span class="num">3</span><span><b>Un rappel vous est envoyé</b><br />48&nbsp;h avant la séance.</span></li>
        </ol>
      </div>
      <RdvForm />
    </div>
  </section>
</BaseLayout>
