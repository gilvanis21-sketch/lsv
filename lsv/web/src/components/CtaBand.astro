---
interface Props { title?: string; text?: string; href?: string; label?: string }
const {
  title = 'Envie d’en parler ?',
  text = 'Envoyez une demande de rendez-vous, nous vous répondons sous 48 h.',
  href = '/rendez-vous/',
  label = 'Prendre rendez-vous',
} = Astro.props;
---
<section aria-label="Prendre rendez-vous">
  <div class="wrap">
    <div class="cta-band rv">
      <div>
        <h2>{title}</h2>
        <p>{text}</p>
      </div>
      <a class="btn btn-a" href={href}>{label}</a>
    </div>
  </div>
</section>
