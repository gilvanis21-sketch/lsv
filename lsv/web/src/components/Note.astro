---
// Encadré d'information (ex. « Information, pas diagnostic »).
interface Props { title: string }
const { title } = Astro.props;
---
<div class="note rv" role="note">
  <svg class="note-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-5M12 8h.01" stroke-linecap="round"/></svg>
  <span><b>{title}</b> <slot /></span>
</div>
